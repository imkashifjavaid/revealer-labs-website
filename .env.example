# Canonical production origin used by metadata, robots.txt and sitemap.xml.
# Include the protocol and omit paths, query strings and fragments.
SITE_URL=https://your-production-domain.example

# Production email delivery (required)
# Create a Resend API key and verify the domain used by CONTACT_FROM_EMAIL.
CONTACT_EMAIL_PROVIDER=resend
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Local validation only. Never use the mock provider in production.
# CONTACT_EMAIL_PROVIDER=mock
# CONTACT_ENABLE_TEST_ADAPTER=true
# CONTACT_MOCK_RESULT=success
# CONTACT_MOCK_DELAY_MS=500
